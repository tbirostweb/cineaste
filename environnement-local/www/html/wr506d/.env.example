# Variables de l'API (noms uniquement, AUCUNE valeur réelle ici).
# Production : onglet Environment de Dokploy. Développement : .env.local.
APP_ENV=prod
APP_SECRET=
DEFAULT_URI=
DATABASE_URL=
CORS_ALLOW_ORIGIN=

# JWT (lexik) : chemins des clés et phrase de passe.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

# Cookie de session HttpOnly : Secure (1 par défaut) et SameSite (strict|lax).
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=strict

# IP/CIDR du proxy (Traefik/Dokploy) autorisé à transmettre X-Forwarded-*.
# Sans valeur correcte, toutes les requêtes semblent venir du proxy et partagent
# les quotas (connexion, API anonyme).
TRUSTED_PROXIES=

# Migrations automatiques au démarrage du conteneur (1 par défaut).
# 0 : les lancer à part, après sauvegarde, en job contrôlé.
RUN_MIGRATIONS=1

# Envoi d'e-mails : aucun flux transactionnel n'existe à ce jour.
MAILER_DSN=
