# Variables de build du front (Vite les fige à la compilation).
# En production, les renseigner dans Dokploy → onglet Build Arguments.
# Ce fichier est un modèle : il ne contient aucune valeur sensible.

VITE_API_BASE_URL=http://localhost:8319
VITE_API_URL=http://localhost:8319/api
VITE_API_URL_AUTH=http://localhost:8319/auth
VITE_API_URL_USER=http://localhost:8319/api/me
VITE_API_URL_REGISTER=http://localhost:8319/api/users
VITE_API_URL_MEDIA=http://localhost:8319/api/media_objects

# Mesure d'audience (optionnelle). Laisser vide = aucun traceur, aucun bandeau.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
